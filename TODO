# If expection has %s it breaks it , is this the only case ?
class DictionarySizeMismatchError(MustEqualError):

    def __init__(self, a: dict[Any, Any], b: dict[Any, Any], detail='') -> None:
        msg = '%s != %s | %s' % (a, b, 1, 1)
        super().__init__(msg)
